var list = document.querySelectorAll("ul");
function parseSalary(salaryString) {
    return Number(salaryString.replace(/[$,]/g, ""));
}
function sortList(lists) {
    lists.forEach(function(ul) {
        var items = Array.from(ul.querySelectorAll("li"));
        var sort = items.sort(function(a, b) {
            return parseSalary(b.dataset.salary) - parseSalary(a.dataset.salary);
        });
        sort.forEach(function(li) {
            return ul.appendChild(li);
        });
    });
}
function getEmployees(lists) {
    var result = [];
    lists.forEach(function(ul) {
        ul.querySelectorAll("li").forEach(function(li) {
            result.push({
                name: li.textContent.trim(),
                position: li.dataset.position,
                salary: parseSalary(li.dataset.salary),
                age: Number(li.dataset.age)
            });
        });
    });
    return result;
}
